{
  "name": "rcodex",
  "private": true,
  "version": "0.1.6",
  "description": "专为 Codex 做的本机路由转发工具：把多个模型服务商聚合成一份目录，按模型精确转发。",
  "keywords": [
    "codex",
    "openai",
    "llm",
    "gateway",
    "routing",
    "multi-provider",
    "tauri",
    "desktop",
    "rcodex"
  ],
  "homepage": "https://github.com/NidusP/rcodex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NidusP/rcodex.git"
  },
  "bugs": {
    "url": "https://github.com/NidusP/rcodex/issues"
  },
  "author": {
    "name": "populus",
    "email": "30283065+NidusP@users.noreply.github.com",
    "url": "https://github.com/NidusP"
  },
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "website:dev": "pnpm --dir website dev",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "9.6.3",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.2",
    "lucide-react": "^1.29.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
