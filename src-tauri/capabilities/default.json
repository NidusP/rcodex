{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal desktop capability for the main application window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "opener:default",
    "process:default"
  ]
}
