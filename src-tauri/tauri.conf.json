{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R Codex",
  "version": "0.1.2",
  "identifier": "io.rcodex",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "R Codex",
        "hiddenTitle": true,
        "width": 980,
        "height": 760,
        "minWidth": 740,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "populus",
    "copyright": "Copyright © 2026 populus",
    "homepage": "https://github.com/NidusP/rcodex",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/codex-launcher",
      "binaries/codex-gateway"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Codex 多渠道本机路由转发",
    "longDescription": "R Codex 是专为 Codex 做的本机路由转发工具。把多个模型服务商的模型收成一份目录，经本机回环 Gateway 按模型精确转发。启动的 Codex 使用独立配置与会话，不读取或修改用户原来的 Codex 环境。",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QjFEREI5NTEzMDIzMTcKUldRWEl6QlJ1ZDJ4YWRlNWxMS281cEdHVEhqeVQ2V3BwMmVhN1NmZk9yRCtxY0J2aUJzSHVZdjEK",
      "endpoints": [
        "https://github.com/NidusP/rcodex/releases/latest/download/latest-{{target}}.json",
        "https://github.com/NidusP/rcodex/releases/latest/download/latest.json"
      ]
    }
  }
}
